# PostgreSQL (same DB as Node backend is OK — uses ai_* tables only)
DATABASE_URL=postgresql://postgres:password@localhost:5432/road_saas

# Document ingestion
PDF_PATH=./data/mybook.pdf
# Or put all three books in ./data and run: python -m app.ingest --all

# --- Local (default, no API cost): Ollama ---
# Install: https://ollama.com — then: bash scripts/pull_ollama_models.sh
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e2b-it-qat
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Grounded answers via local/cloud LLM (falls back to extractive if LLM fails)
CHAT_USE_LLM=true

# Lighter machine: LLM_MODEL=llama3.2:3b

# --- Optional cloud (paid) ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_DIMENSION=1536

# Retrieval tuning
RAG_TOP_K=8
INGEST_EMBED_BATCH_SIZE=8
# On 2GB VPS use false so ingest finishes (text RAG still works):
INGEST_EXTRACT_TABLES=false
RAG_VECTOR_WEIGHT=0.7
RAG_KEYWORD_WEIGHT=0.3

# Reply in Latin when the user typed Latin (answer_cyrillic is always returned too)
REPLY_IN_USER_SCRIPT=true

# Service
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO
OLLAMA_NUM_PREDICT=600
OLLAMA_NUM_CTX=8192
# false turns off Gemma 4 thinking (faster)
OLLAMA_THINK=false
# facts (checked, cited card answers) | text (free LLM answer)
ANSWER_MODE=facts
OLLAMA_REPEAT_PENALTY=1.1
